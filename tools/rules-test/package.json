{
  "name": "pmlm-rules-test",
  "private": true,
  "type": "module",
  "description": "Tests firestore.rules in the Firestore emulator (needs Java 11+). Run `npm run emulator` in one terminal, then `npm test`.",
  "scripts": {
    "emulator": "firebase setup:emulators:firestore && java -jar ~/.cache/firebase/emulators/cloud-firestore-emulator-*.jar --host 127.0.0.1 --port 8080",
    "test": "node --test --test-reporter=spec rules.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-tools": "13.24.2"
  }
}
