{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "play-more-learn-more",
  "main": "../../worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../_site",
    "binding": "ASSETS",
    "run_worker_first": ["/"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
