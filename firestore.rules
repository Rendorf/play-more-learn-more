rules_version = '2';

// Play More Learn More family accounts.
// Parents sign in with email/password or Google; children's devices sign in anonymously and join a
// family with a short-lived link code. Only parents and linked devices of a family can read or
// write that family's data. Paste this whole file into Firebase console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAnonymous() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isParent(fid) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(fid)/parents/$(request.auth.uid));
    }
    function isDevice(fid) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(fid)/devices/$(request.auth.uid));
    }
    function isMember(fid) { return isParent(fid) || isDevice(fid); }
    function validCode(code, fid, role) {
      let c = get(/databases/$(database)/documents/codes/$(code)).data;
      return c.fid == fid && c.role == role && c.expires > request.time;
    }

    // Where each signed-in account's family is. A pointer only: it never grants access by itself.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Link codes: readable one at a time by id (never listed), made and removed by that family's parents.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if isParent(request.resource.data.fid)
        && request.resource.data.role in ['device', 'parent']
        && request.resource.data.expires is timestamp
        && request.resource.data.expires < request.time + duration.value(2, 'd');
      allow delete: if isParent(resource.data.fid);
    }

    match /families/{fid} {
      // A parent's first sign-in creates a family whose id is their own account id.
      allow create: if signedIn() && !isAnonymous() && request.auth.uid == fid;
      allow read, update: if isMember(fid);

      match /parents/{uid} {
        allow create: if signedIn() && !isAnonymous() && request.auth.uid == uid
          && (fid == uid || validCode(request.resource.data.code, fid, 'parent'));
        allow read: if isParent(fid) || (signedIn() && request.auth.uid == uid);
        allow delete: if isParent(fid);
      }

      // player: a parent can lock the device to one child from their own login; the device itself can't change it
      match /devices/{uid} {
        allow create: if signedIn() && request.auth.uid == uid
          && validCode(request.resource.data.code, fid, 'device') && !('player' in request.resource.data);
        allow read: if isParent(fid) || (signedIn() && request.auth.uid == uid);
        allow update: if (signedIn() && request.auth.uid == uid
            && request.resource.data.code == resource.data.code
            && request.resource.data.get('player', null) == resource.data.get('player', null))
          || (isParent(fid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['player'])
            && (!('player' in request.resource.data) || (request.resource.data.player is string && request.resource.data.player.size() <= 24)));
        allow delete: if isParent(fid) || (signedIn() && request.auth.uid == uid);
      }

      match /players/{pid} {
        allow read, write: if isMember(fid);
      }
    }

    // ---------- Family test extras (src/online.js) ----------
    // Each device signs in anonymously for these, separately from family accounts. Nothing here can read or
    // change family data. The owner reads stats and feedback on stats.html after adding their account id to admins.

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // An optional string field of at most n characters, an optional number between 0 and max
    function optStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function optNum(d, k, max) { return !(k in d) || (d[k] is number && d[k] >= 0 && d[k] <= max); }
    function stamp(d) {
      return d.d is string && d.d.size() <= 24 && optStr(d, 'p', 24) && optStr(d, 'v', 40) && optStr(d, 'day', 10)
        && optStr(d, 'dev', 10) && optStr(d, 'src', 24) && optNum(d, 't', 9999999999999) && optNum(d, 'g', 9);
    }

    // Written once in the Firebase console; an account can only check its own entry
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // Anonymous play stats: no names, create only
    match /events/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['d', 'p', 'type', 'g', 'sk', 'mode', 'n', 'ok', 'secs', 'm', 'v', 'day', 'dev', 'src', 'msg', 't'])
        && request.resource.data.type in ['open', 'player', 'lesson', 'round', 'place', 'wishset', 'wish', 'problem', 'invite']
        && stamp(request.resource.data) && optStr(request.resource.data, 'sk', 40) && optStr(request.resource.data, 'mode', 12)
        && optNum(request.resource.data, 'n', 1000) && optNum(request.resource.data, 'ok', 1000) && optNum(request.resource.data, 'secs', 86400)
        && optNum(request.resource.data, 'm', 1000) && optStr(request.resource.data, 'msg', 500);
      allow read: if isAdmin();
    }

    // 🚩 question reports, parents' messages and 🐞 bug reports (with the game's own diagnostics, no names): create only
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['d', 'p', 'kind', 'reason', 'g', 'sk', 'lvl', 'mode', 'q', 'ans', 'inp', 'text', 'name', 'v', 'day', 'dev', 'src', 't', 'what', 'screen', 'log', 'sync', 'err'])
        && request.resource.data.kind in ['question', 'general', 'bug']
        && optStr(request.resource.data, 'what', 20) && optStr(request.resource.data, 'screen', 20) && optStr(request.resource.data, 'log', 2000)
        && optStr(request.resource.data, 'sync', 600) && optStr(request.resource.data, 'err', 1000)
        && stamp(request.resource.data) && optStr(request.resource.data, 'reason', 20) && optStr(request.resource.data, 'sk', 40)
        && optNum(request.resource.data, 'lvl', 9) && optStr(request.resource.data, 'mode', 12) && optStr(request.resource.data, 'q', 300)
        && optStr(request.resource.data, 'ans', 80) && optStr(request.resource.data, 'inp', 80) && optStr(request.resource.data, 'text', 1000)
        && optStr(request.resource.data, 'name', 40);
      allow read: if isAdmin();
    }

    // Leaderboard: one document per player per device ({playerId}_{account}), written only by that device
    function validBoard(d) {
      return d.keys().hasOnly(['pid', 'owner', 'hid', 'nick', 'av', 'hat', 'g', 'pts', 'min', 'mst', 'str', 'frz', 'day', 'q', 'acc', 'wk', 'wpts', 'wmin', 'wq', 'wmst', 'v', 't'])
        && d.pid is string && d.pid.size() <= 24 && (!('hid' in d) || d.hid is bool)
        && optStr(d, 'nick', 24) && optStr(d, 'av', 16) && optStr(d, 'hat', 16) && optNum(d, 'g', 9)
        && optNum(d, 'pts', 100000000) && optNum(d, 'min', 1000000) && optNum(d, 'mst', 1000) && optNum(d, 'str', 10000) && optNum(d, 'frz', 9)
        && optStr(d, 'day', 10) && optNum(d, 'q', 10000000) && optNum(d, 'acc', 100) && optStr(d, 'wk', 8)
        && optNum(d, 'wpts', 100000000) && optNum(d, 'wmin', 1000000) && optNum(d, 'wq', 10000000) && optNum(d, 'wmst', 1000)
        && optStr(d, 'v', 40) && optNum(d, 't', 9999999999999);
    }
    match /leaderboard/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && id == request.resource.data.pid + '_' + request.auth.uid
        && (resource == null || resource.data.owner == request.auth.uid)
        && validBoard(request.resource.data);
      allow delete: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);
    }

    // Daily reminder subscription for one device. lastSent and lastMsg are written by the sender (admin SDK).
    match /push/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['owner', 'sub', 'tz', 'off', 'hour', 'kids', 't', 'lastSent', 'lastMsg'])
        && request.resource.data.owner == uid
        && request.resource.data.sub is map && request.resource.data.sub.keys().hasOnly(['endpoint', 'p256dh', 'auth'])
        && request.resource.data.sub.endpoint is string && request.resource.data.sub.endpoint.size() <= 1000
        && request.resource.data.sub.endpoint.matches('https://.*')
        && optStr(request.resource.data.sub, 'p256dh', 200) && optStr(request.resource.data.sub, 'auth', 100)
        && request.resource.data.hour is int && request.resource.data.hour >= 0 && request.resource.data.hour <= 23
        && optStr(request.resource.data, 'tz', 64) && (!('off' in request.resource.data) || request.resource.data.off is int)
        && request.resource.data.kids is list && request.resource.data.kids.size() <= 12;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Invite a friend. A child's link carries a random code owned by their device's account; only that account
    // can see who came through it. A new device is counted for one invite only (referred), reports its own
    // progress, and the inviting device marks each friend rewarded once, after their first full round.
    function inviteOwner(code) {
      return signedIn() && get(/databases/$(database)/documents/invites/$(code)).data.owner == request.auth.uid;
    }
    function validFriend(d) {
      return d.keys().hasOnly(['t', 'name', 'joined', 'played', 'rewarded']) && optStr(d, 'name', 16)
        && optNum(d, 't', 9999999999999) && optNum(d, 'joined', 9999999999999) && optNum(d, 'played', 9999999999999)
        && optNum(d, 'rewarded', 9999999999999);
    }
    match /invites/{code} {
      allow get: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn() && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['owner', 'pid', 't'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.pid is string && request.resource.data.pid.size() <= 24
        && optNum(request.resource.data, 't', 9999999999999);

      match /friends/{uid} {
        allow get, list: if (signedIn() && request.auth.uid == uid) || inviteOwner(code);
        allow create: if signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/referred/$(uid)).data.code == code
          && validFriend(request.resource.data) && !('rewarded' in request.resource.data);
        allow update: if validFriend(request.resource.data) && (
          (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t', 'name', 'joined', 'played']))
          || (inviteOwner(code)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewarded'])
            && !('rewarded' in resource.data) && ('played' in resource.data)));
      }
    }
    match /referred/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 't'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z0-9]{6}$')
        && optNum(request.resource.data, 't', 9999999999999)
        && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.owner != uid;
    }
  }
}
