{
  "name": "pmlm-tests",
  "private": true,
  "type": "module",
  "description": "Everything that must pass before a change reaches main. Run ./run-all.sh from this folder (or see README → Tests).",
  "scripts": {
    "unit": "node --test --test-reporter=spec unit/*.test.mjs",
    "e2e": "firebase emulators:exec --project demo-pmlm --config ../firebase.json --only auth,firestore \"playwright test\"",
    "fixtures": "node make-fixtures.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "firebase-tools": "15.32.1"
  }
}
